// ============================================================
// Scenario 2 — PowerShell Suspicious Web Request
// Table:     DeviceProcessEvents (Microsoft Defender for Endpoint)
// MITRE:     T1059.001 PowerShell, T1105 Ingress Tool Transfer
// Entities:  Account -> AccountName, Host -> DeviceName,
//            Process -> ProcessCommandLine
// ============================================================

// --- Rule used in the lab (scoped to the lab VM) ---
DeviceProcessEvents
| where DeviceName == "lamavmonboardin"
| where FileName == "powershell.exe"
| where ProcessCommandLine contains "invoke-webrequest"
| project
    TimeGenerated,
    DeviceName,
    AccountName,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine


